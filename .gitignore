# Rust
/src-tauri/target/
# Tauri's own build.rs generates ACL/capability schema files here on every
# build — regenerated, not hand-authored, standard Tauri v2 .gitignore entry.
/src-tauri/gen/schemas/

# Node
/node_modules/

# Frontend build output — regenerated by `npm run build` (also src-tauri's own
# beforeBuildCommand); tauri.conf.json's frontendDist points here.
/dist/

# Editor/OS cruft
.DS_Store
