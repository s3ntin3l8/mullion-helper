{
  "name": "mullion-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Native tray app for the Mullion SSH-agent bridge",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:worker-sea": "node scripts/build-worker-sea.mjs",
    "stage:sidecar": "npm run build:worker-sea && node scripts/stage-sidecar.mjs",
    "ci:prepare": "npm run stage:sidecar && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
