{
  "name": "mullion-helper",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "description": "Native tray app for the Mullion SSH-agent bridge",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "npm run typecheck && vite build",
    "build:worker-sea": "node scripts/build-worker-sea.mjs",
    "stage:sidecar": "npm run build:worker-sea && node scripts/stage-sidecar.mjs",
    "ci:prepare": "npm run stage:sidecar && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . && npm run check:versions && npm run check:icons",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "check:icons": "node scripts/generate-tray-icon.mjs --check",
    "icons:tray": "node scripts/generate-tray-icon.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postject": "1.0.0-alpha.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
